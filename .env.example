# REC — Environment Variables Template
# Copy to .env and fill in real values before starting

# ─── Database ───────────────────────────────────────
DB_PASSWORD=change_me_in_production

# ─── MinIO Object Storage ────────────────────────────
MINIO_ACCESS_KEY=recadmin
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=rec-images

# ─── Auth ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_in_production

# ─── Edge Node ───────────────────────────────────────
EDGE_API_TOKEN=change_me_in_production
REDIS_URL=redis://localhost:6379/0

# ─── AI Models ───────────────────────────────────────
# AuraFace v1 model — downloaded automatically from HuggingFace on first run
# HUGGINGFACE_TOKEN=hf_... (only needed for gated models)

# ─── Monitoring ──────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me_in_production
